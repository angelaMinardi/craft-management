---
interface Props {
  animation: 'waving' | 'idle' | 'knitting' | 'jumping';
  size?: number;
  class?: string;
}

const { animation, size = 160, class: className = '' } = Astro.props;

const staticImage: Record<string, string> = {
  waving: '/images/pip/waving.png',
  idle: '/images/pip/happy.png',
  knitting: '/images/pip/focused.png',
  jumping: '/images/pip/happy.png',
};

const src = staticImage[animation];

const aspects: Record<string, number> = {
  waving: 530 / 454,
  idle: 478 / 504,
  knitting: 514 / 450,
  jumping: 370 / 482,
};
const ratio = aspects[animation] ?? 1;
const width = Math.round(size * ratio);
---

<img
  class:list={['animated-pip', className]}
  src={src}
  alt={`Our mascot crow`}
  width={width}
  height={size}
/>

<style>
  .animated-pip {
    max-width: 100%;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    pointer-events: none;
    animation: pip-float 4s ease-in-out infinite;
  }

  @keyframes pip-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animated-pip {
      animation: none;
    }
  }
</style>
