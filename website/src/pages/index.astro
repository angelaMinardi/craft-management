---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTA from '../components/CTA.astro';
import AnimatedPip from '../components/AnimatedPip.astro';
import LaunchTracker from '../components/LaunchTracker.astro';
import MascotPoll from '../components/MascotPoll.astro';
import { getCtaConfig } from '../config/cta';
import '../styles/quiz.css';

const ctaConfig = getCtaConfig(import.meta.env);

const features = [
  {
    eyebrow: 'Step 1',
    title: 'Spot a pattern you love',
    description: 'Share from Ravelry, Etsy, TikTok, YouTube, or blogs. Corvid Craft grabs it before it disappears into your bookmarks forever.',
    icon: '🔗',
  },
  {
    eyebrow: 'Step 2',
    title: 'Actually keep track of it',
    description: 'Want to Make, In Progress, Completed — your patterns move with you instead of disappearing into a bookmark graveyard.',
    icon: '✓',
  },
  {
    eyebrow: 'Step 3',
    title: 'Make the thing',
    description: 'Row counter with voice mode, project notes, yarn matching — everything you need to go from casting on to weaving in ends.',
    icon: '🧶',
  },
];
---

<BaseLayout
  title="Corvid Craft — Your craft library, in your pocket"
  description="Save patterns from Ravelry, Etsy, TikTok, and anywhere else. Track projects, add notes, and stop losing that pattern you saved three months ago. For crafters who collect more patterns than they can make."
>
  <div class="home gradient-mesh">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-mascot-wrap">
        <AnimatedPip animation="idle" size={160} class="hero-mascot" />
      </div>
      <h1 id="hero-heading" class="hero-title">
        Your craft library,<br /><span class="hero-title-accent">in your pocket</span>
      </h1>
      <p class="hero-subtitle">
        Save any pattern you find — Ravelry, TikTok, Etsy, wherever — and actually track it from "ooh I want to make this" to done.
      </p>
      <p class="hero-tagline">
        No more losing patterns in your bookmarks. No more 47 open tabs. Just your projects, organized.
      </p>
      <div class="hero-cta-stack">
        <div class="hero-cta">
          <CTA
            href={ctaConfig.primary.href}
            label={ctaConfig.primary.label}
            primary={true}
            dataCta="cta_impression"
            dataDestination={ctaConfig.primary.destination}
            dataMode={ctaConfig.mode}
            dataPageSection="hero"
            dataFallbackUsed="false"
          />
        </div>
        <div class="hero-cta">
          <CTA
            href={ctaConfig.fallback.href}
            label={ctaConfig.fallback.label}
            primary={false}
            dataCta="cta_impression"
            dataDestination={ctaConfig.fallback.destination}
            dataMode={ctaConfig.mode}
            dataPageSection="hero"
            dataFallbackUsed="true"
          />
        </div>
      </div>
      <p class="hero-note">
        {ctaConfig.mode === 'liveFirst' ? 'iOS only. Designed for crafters who save patterns from everywhere.' : 'TestFlight beta is open — 100 spots available. iOS only.'}
      </p>
    </section>

    <section class="trust-row" aria-label="Trust signals">
      <p class="trust-chip reveal">Built by a crafter who kept losing patterns</p>
      <p class="trust-chip reveal">Privacy-first by default</p>
      <p class="trust-chip reveal">No tracking, ever</p>
    </section>

    <section class="features" aria-labelledby="features-heading">
      <h2 id="features-heading" class="section-title reveal">Here's the idea</h2>
      <div class="features-grid">
        {features.map((f, i) => (
          <div class="feature-wrap reveal" style={`--reveal-order: ${i}`}>
            <FeatureCard title={f.title} description={f.description} icon={f.icon} eyebrow={f.eyebrow} />
          </div>
        ))}
      </div>
    </section>

    <section class="showcase" aria-labelledby="showcase-heading" id="showcase">
      <h2 id="showcase-heading" class="section-title reveal">See it in action</h2>
      <p class="showcase-subtitle reveal">Share a pattern PDF and Corvid Craft does the rest.</p>

      <div class="demo-container reveal" id="demo">
        <!-- State 1: PDF with action button -->
        <div class="demo-initial" id="demo-initial">
          <div class="demo-pdf-wrap">
            <div class="phone-frame">
              <div class="phone-notch" aria-hidden="true"></div>
              <img src="/images/showcase/pdf-charts.png" alt="Page 1 of the Pompomhat with Star Pattern PDF" width="554" height="1200" loading="lazy" class="demo-pdf" id="demo-pdf" />
            </div>
          </div>
          <button class="demo-organize-btn" id="demo-btn" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            Organize this pattern
          </button>
        </div>

        <!-- State 2: Processing animation -->
        <div class="demo-processing" id="demo-processing" style="display:none;">
          <img src="/images/pip/thinking.png" alt="Pip thinking" width="120" height="120" class="demo-pip" />
          <div class="demo-status" id="demo-status">Reading PDF...</div>
          <div class="demo-progress-bar"><div class="demo-progress-fill" id="demo-progress"></div></div>
        </div>

        <!-- State 3: Results -->
        <div class="demo-results" id="demo-results" style="display:none;">
          <img src="/images/pip/happy.png" alt="Pip happy" width="80" height="80" class="demo-pip-done" />
          <div class="demo-cards">
            <div class="demo-card" style="--i:0">
              <div class="demo-card-icon">
                <div class="phone-frame phone-frame-mini">
                  <div class="phone-notch" aria-hidden="true"></div>
                  <img src="/images/showcase/step-tracking.png" alt="Step-by-step tracking view showing Step 1 of 6 with row counter" width="554" height="1200" loading="lazy" class="demo-card-screenshot" />
                </div>
              </div>
              <div class="demo-card-body">
                <h4 class="demo-card-title">6 steps parsed</h4>
                <p class="demo-card-desc">Each instruction broken out with repeat tracking, round counters, and size selectors.</p>
              </div>
            </div>
            <div class="demo-card" style="--i:1">
              <div class="demo-card-icon">
                <div class="phone-frame phone-frame-mini">
                  <div class="phone-notch" aria-hidden="true"></div>
                  <img src="/images/showcase/knitting-mode.png" alt="Interactive knitting mode showing the star chart at Row 7" width="554" height="1200" loading="lazy" class="demo-card-screenshot" />
                </div>
              </div>
              <div class="demo-card-body">
                <h4 class="demo-card-title">1 chart extracted</h4>
                <p class="demo-card-desc">Colorwork charts detected and ready for row-by-row knitting mode.</p>
              </div>
            </div>
            <div class="demo-card" style="--i:2">
              <div class="demo-card-icon">
                <div class="phone-frame phone-frame-mini">
                  <div class="phone-notch" aria-hidden="true"></div>
                  <img src="/images/showcase/knitting-materials.png" alt="Pattern Info view showing extracted materials, gauge, needle sizes, and techniques" width="554" height="1200" loading="lazy" class="demo-card-screenshot" />
                </div>
              </div>
              <div class="demo-card-body">
                <h4 class="demo-card-title">Materials saved</h4>
                <p class="demo-card-desc">Yarn weight, needle sizes, and gauge pulled from the PDF automatically.</p>
              </div>
            </div>
          </div>
          <button class="demo-reset-btn" id="demo-reset" type="button">Try again</button>
        </div>
      </div>
    </section>

    <section class="maker-story" aria-labelledby="maker-heading">
      <div class="maker-inner reveal">
        <div class="maker-photos">
          <img src="/images/maker/sunflower-blanket.jpg" alt="A crocheted sunflower granny square blanket in green and yellow" class="maker-photo maker-photo-main" width="400" height="400" loading="lazy" />
          <img src="/images/maker/cat-hat.jpg" alt="A black cat wearing a handmade crocheted hat with pom-poms" class="maker-photo maker-photo-accent" width="300" height="300" loading="lazy" />
        </div>
        <div class="maker-text">
          <h2 id="maker-heading" class="maker-title">Why I built this</h2>
          <p>I am a pattern hoarder. I love making gifts for friends (and their pets), new items for myself, and learning new techniques. But after a year of accumulating TikTok videos, Etsy patterns, and bookmarked blog posts, I kept losing them. I tried some commonly recommended apps only to find them clunky and not very inspirational.</p>
          <p>So I built this app for myself — and hopefully the rest of the crafting community can find some use from it too! I'm getting into leatherworking and beading, so this is meant to be a tool for <em>all</em> crafters as it expands, not just fiber artists. I'm looking forward to connecting with all of you and building this out together.</p>
          <p class="maker-sign-off">— Angela</p>
        </div>
      </div>
    </section>

    <section class="beta-tracker-section reveal" aria-label="Beta launch progress">
      <LaunchTracker />
    </section>

    <section class="quiz-promo" aria-labelledby="quiz-promo-heading">
      <div class="quiz-promo-inner reveal">
        <img src="/images/pip/curious.png" alt="Our mascot crow looking curious" class="quiz-promo-pip" width="100" height="100" />
        <div class="quiz-promo-content">
          <h2 id="quiz-promo-heading" class="quiz-promo-title">What kind of crafter are you?</h2>
          <p class="quiz-promo-text">Take the quiz to discover your crafting archetype. It takes 2 minutes and the results are surprisingly accurate.</p>
          <a href="/quiz" class="pv-button-primary quiz-promo-btn">Take the Quiz</a>
        </div>
      </div>
    </section>

    <section class="poll-section reveal" aria-label="Mascot naming poll">
      <MascotPoll />
    </section>

    <section class="cta-section" aria-labelledby="cta-heading">
      <h2 id="cta-heading" class="visually-hidden">Join the beta</h2>
      <p class="cta-text reveal">Stop losing patterns. Start finishing projects.</p>
      <div class="cta-actions reveal">
        <CTA
          href={ctaConfig.primary.href}
          label={ctaConfig.primary.label}
          primary={true}
          dataCta="cta_impression"
          dataDestination={ctaConfig.primary.destination}
          dataMode={ctaConfig.mode}
          dataPageSection="closing"
          dataFallbackUsed="false"
        />
        <CTA
          href={ctaConfig.fallback.href}
          label={ctaConfig.fallback.label}
          primary={false}
          dataCta="cta_impression"
          dataDestination={ctaConfig.fallback.destination}
          dataMode={ctaConfig.mode}
          dataPageSection="closing"
          dataFallbackUsed="true"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initReveals() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const els = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0 }
    );
    els.forEach((el) => io.observe(el));
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveals);
  } else {
    initReveals();
  }

  // Interactive demo
  (function initDemo() {
    const btn = document.getElementById('demo-btn');
    const resetBtn = document.getElementById('demo-reset');
    const initial = document.getElementById('demo-initial');
    const processing = document.getElementById('demo-processing');
    const results = document.getElementById('demo-results');
    const status = document.getElementById('demo-status');
    const progress = document.getElementById('demo-progress');
    if (!btn) return;

    const steps = [
      { text: 'Reading PDF...', pct: 20 },
      { text: 'Parsing instructions...', pct: 45 },
      { text: 'Extracting charts...', pct: 70 },
      { text: 'Organizing steps...', pct: 90 },
      { text: 'Done!', pct: 100 },
    ];

    function runDemo() {
      initial.style.display = 'none';
      processing.style.display = 'flex';
      results.style.display = 'none';

      let i = 0;
      function next() {
        if (i >= steps.length) {
          setTimeout(showResults, 400);
          return;
        }
        status.textContent = steps[i].text;
        progress.style.width = steps[i].pct + '%';
        i++;
        setTimeout(next, 700);
      }
      next();
    }

    function showResults() {
      processing.style.display = 'none';
      results.style.display = 'flex';
    }

    function resetDemo() {
      results.style.display = 'none';
      processing.style.display = 'none';
      progress.style.width = '0%';
      initial.style.display = 'flex';
    }

    btn.addEventListener('click', runDemo);
    resetBtn.addEventListener('click', resetDemo);
  })();
</script>

<style>
  .home {
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .hero {
    text-align: center;
    padding: var(--space-4xl) var(--space-lg) var(--space-3xl);
    max-width: var(--content-max);
    margin: 0 auto;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero {
      max-width: none;
      padding: var(--space-4xl) var(--space-2xl) var(--space-3xl);
    }

    .hero-subtitle,
    .hero-tagline {
      max-width: 42rem;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-section {
      padding: var(--space-4xl) var(--space-2xl);
    }
  }

  .hero-mascot-wrap {
    margin: 0 auto var(--space-xl);
    filter: drop-shadow(var(--shadow-glow-coral));
  }

  .hero-mascot {
    width: 160px;
    height: 160px;
    max-width: 100%;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    animation: float 4s ease-in-out infinite;
  }

  @media (min-width: 1024px) {
    .hero-mascot {
      width: 220px;
      height: 220px;
    }
  }

  .hero-title {
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-tight);
    color: var(--deep-plum);
    margin: 0 0 var(--space-lg);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.2s both;
  }

  .hero-title-accent {
    background: linear-gradient(135deg, var(--soft-coral), var(--sage-green));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title::after {
    content: '';
    display: block;
    width: 4rem;
    height: 4px;
    margin: var(--space-md) auto 0;
    background: linear-gradient(90deg, var(--soft-coral), var(--sage-green));
    border-radius: var(--radius-full);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.35s both;
  }

  .hero-subtitle {
    font-size: var(--text-subtitle);
    line-height: var(--line-height-relaxed);
    color: var(--deep-plum);
    margin-top: 0;
    margin-bottom: var(--space-md);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.4s both;
  }

  .hero-tagline {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin-top: 0;
    margin-bottom: var(--space-xl);
    line-height: var(--line-height-relaxed);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.5s both;
  }

  .hero-cta {
    margin-bottom: var(--space-sm);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.6s both;
  }

  .hero-cta-stack {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero-note {
    font-size: var(--text-small);
    color: var(--text-muted);
    margin: 0;
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.7s both;
  }

  .section-title {
    font-size: var(--text-title);
    font-weight: 700;
    letter-spacing: var(--letter-tight);
    color: var(--deep-plum);
    text-align: center;
    margin: 0 0 var(--space-2xl);
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s var(--ease-out-expo), transform 0.7s var(--ease-out-expo);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .feature-wrap.reveal {
    transition-delay: calc(var(--reveal-order, 0) * 0.1s);
  }

  .features {
    padding: var(--space-4xl) 0;
  }

  .trust-row {
    margin: 0 auto;
    max-width: var(--content-max);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0 var(--space-md);
  }

  .trust-chip {
    margin: 0;
    font-size: var(--text-small);
    color: var(--text-muted);
    font-style: italic;
  }

  .trust-chip::before {
    content: '✓ ';
    color: var(--sage-green);
    font-style: normal;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
    }
  }

  .maker-story {
    padding: var(--space-3xl) var(--space-lg);
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .maker-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    align-items: center;
  }

  .maker-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    flex-shrink: 0;
    width: 100%;
    max-width: 360px;
  }

  @media (min-width: 768px) {
    .maker-inner {
      flex-direction: row;
      align-items: center;
    }

    .maker-photos {
      width: 280px;
      max-width: 280px;
    }
  }

  .maker-photo {
    border-radius: 12px;
    object-fit: cover;
    width: 100%;
    aspect-ratio: 1;
    box-shadow: var(--shadow-soft);
  }

  .maker-text {
    flex: 1;
  }

  .maker-title {
    font-size: var(--text-title);
    font-weight: 700;
    color: var(--deep-plum);
    margin: 0 0 var(--space-md);
  }

  .maker-text p {
    color: var(--text-body);
    line-height: var(--line-height-body);
    margin: 0 0 var(--space-sm);
  }

  .maker-sign-off {
    font-style: italic;
    color: var(--text-muted);
    margin-top: var(--space-md);
  }

  .cta-section {
    text-align: center;
    padding: var(--space-4xl) var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .cta-text {
    font-size: var(--text-title);
    font-weight: 600;
    color: var(--deep-plum);
    margin: 0 0 var(--space-xl);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }

  .quiz-promo {
    padding: var(--space-3xl) var(--space-lg);
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .quiz-promo-inner {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-xl);
    border-radius: 20px;
    background: color-mix(in srgb, var(--sage-green) 8%, white);
    border: 1.5px solid color-mix(in srgb, var(--sage-green) 25%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .quiz-promo-pip {
    flex-shrink: 0;
    animation: float 4s ease-in-out infinite;
  }

  .quiz-promo-content {
    flex: 1;
  }

  .quiz-promo-title {
    font-size: var(--text-title);
    font-weight: 700;
    color: var(--deep-plum);
    margin: 0 0 var(--space-sm);
  }

  .quiz-promo-text {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0 0 var(--space-md);
    line-height: var(--line-height-relaxed);
  }

  .quiz-promo-btn {
    display: inline-block;
    text-decoration: none;
    text-align: center;
  }

  @media (max-width: 640px) {
    .quiz-promo-inner {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Interactive demo showcase */
  .showcase {
    padding: var(--space-4xl) var(--space-lg);
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .showcase-subtitle {
    text-align: center;
    font-size: var(--text-subtitle);
    color: var(--text-muted);
    max-width: 36rem;
    margin: 0 auto var(--space-2xl);
    line-height: var(--line-height-relaxed);
  }

  .demo-container {
    max-width: 52rem;
    margin: 0 auto;
    min-height: 420px;
    position: relative;
  }

  /* State 1: PDF + button */
  .demo-initial {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .demo-pdf-wrap {
    position: relative;
    width: 240px;
  }

  .demo-pdf {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0;
    border: none;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }

  /* iPhone frame */
  .phone-frame {
    background: #1a1a1e;
    border-radius: 36px;
    padding: 10px;
    position: relative;
    box-shadow:
      0 8px 30px rgba(0, 0, 0, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .phone-frame img {
    border-radius: 26px;
    display: block;
    width: 100%;
    height: auto;
  }

  .phone-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 22px;
    background: #1a1a1e;
    border-radius: 14px;
    z-index: 2;
  }

  /* Mini phone frame for result cards */
  .phone-frame-mini {
    border-radius: 20px;
    padding: 5px;
  }

  .phone-frame-mini img {
    border-radius: 15px;
  }

  .phone-frame-mini .phone-notch {
    top: 8px;
    width: 40px;
    height: 12px;
    border-radius: 8px;
  }

  .demo-organize-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    font-size: var(--text-body);
    font-weight: 700;
    color: white;
    background: var(--sage-green);
    border: none;
    border-radius: var(--radius-full);
