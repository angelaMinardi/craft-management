// Copy to Config.xcconfig and set your Supabase project values.
// Do not commit Config.xcconfig if it contains secrets.
SUPABASE_URL = https://your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
GEMINI_API_KEY = your-gemini-api-key-here
// Optional: for Ravelry PDF / API in Share Extension
RAVELRY_ACCESS_KEY = placeholder
RAVELRY_PERSONAL_KEY = placeholder
// Optional: for Ravelry account connect + import (OAuth 2.0 app at ravelry.com/pro/developer). Redirect URI: patternvault://oauth/ravelry. Set both for the Settings "Connect Ravelry" button.
RAVELRY_OAUTH2_CLIENT_ID = placeholder
RAVELRY_OAUTH2_CLIENT_SECRET = placeholder
// Optional: for production ads (free tier). Replace test IDs in Info.plist with your AdMob app ID and banner ad unit ID, or set here if plist uses $(GAD_APPLICATION_ID).
// GAD_APPLICATION_ID = ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
// GAD_BANNER_AD_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
