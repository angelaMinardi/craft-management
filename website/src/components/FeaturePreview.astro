---
const features = [
  {
    icon: '📎',
    title: 'Save From Anywhere',
    pipSays: "Ravelry, Etsy, TikTok, YouTube, blogs — two taps and it's in the vault.",
    description: 'Hit share from any app. Corvid Craft grabs the details automatically — no copy-pasting links into a notes app.',
  },
  {
    icon: '📋',
    title: 'Track Your Projects',
    pipSays: "Want to Make → In Progress → Completed. The checkmark hits different.",
    description: 'Move patterns through stages, add notes, and always know where you left off. No more "wait, which row was I on?"',
  },
  {
    icon: '🧶',
    title: 'Manage Your Stash',
    pipSays: "You have 47 skeins of DK weight. You know what that means... 48?",
    description: 'Log your yarn, needles, and hooks. Corvid Craft matches what you own to patterns you can actually make with it.',
  },
  {
    icon: '🔍',
    title: 'Find Patterns',
    pipSays: "Tell me your yarn weight and hook size. I'll find what you can make right now.",
    description: 'Search by the materials you already have. Stop buying yarn for a pattern when the perfect skein is already in your stash.',
  },
  {
    icon: '🎯',
    title: 'Row Counter & Voice Mode',
    pipSays: "Say 'Row 42' and I'll mark it. Your hands stay on your needles.",
    description: 'Hands-free row counting. Just say the row number — no putting down your project to tap a screen.',
  },
];
---

<div class="feature-previews" id="feature-previews">
  {features.map((f) => (
    <div class="feature-flip-card" tabindex="0" role="button" aria-label={`${f.title} — tap to reveal details`}>
      <div class="feature-flip-inner">
        <div class="feature-flip-front">
          <span class="feature-icon">{f.icon}</span>
          <h3>{f.title}</h3>
          <span class="tap-hint">Tap to peek</span>
        </div>
        <div class="feature-flip-back">
          <p class="pip-says">"{f.pipSays}"</p>
          <p class="feature-desc">{f.description}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('.feature-flip-card').forEach((card) => {
    card.addEventListener('click', () => card.classList.toggle('flipped'));
    card.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        card.classList.toggle('flipped');
      }
    });
  });
</script>
