# Copy to PatternVault/fastlane/.env and fill in. Do not commit.
# Values come from App Store Connect → Users and Access → Integrations → Team Keys.

# 10-character Key ID, e.g. ABC123XYZ4
ASC_KEY_ID=

# UUID at the top of the Team Keys page, e.g. 69a6de7e-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_ISSUER_ID=

# Path to the AuthKey_XXXXXXXXXX.p8 file. Relative paths are resolved from PatternVault/.
# Recommended: drop the .p8 in PatternVault/fastlane/ so it stays out of git via *.p8.
ASC_KEY_FILEPATH=./fastlane/AuthKey_REPLACE_ME.p8
