default_platform(:ios)

platform :ios do
  desc "Build a Release archive and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      duration: 1200,
      in_house: false
    )

    build_app(
      project: "PatternVault.xcodeproj",
      scheme: "PatternVault",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "PatternVault.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.corvidcraft.app",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload the existing IPA to TestFlight without rebuilding"
  lane :upload_only do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.corvidcraft.app",
      ipa: "build/PatternVault.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
