---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTA from '../components/CTA.astro';
import AnimatedPip from '../components/AnimatedPip.astro';
import LaunchTracker from '../components/LaunchTracker.astro';
import MascotPoll from '../components/MascotPoll.astro';
import { getCtaConfig } from '../config/cta';
import '../styles/quiz.css';

const ctaConfig = getCtaConfig(import.meta.env);

const features = [
  {
    eyebrow: 'Step 1',
    title: 'Spot a pattern you love',
    description: 'Share from Ravelry, Etsy, TikTok, YouTube, or blogs. Pattern Vault grabs it before it disappears into your bookmarks forever.',
    icon: '🔗',
  },
  {
    eyebrow: 'Step 2',
    title: 'Actually keep track of it',
    description: 'Move patterns from Want to Make to In Progress to Completed. No more losing that perfect sweater pattern in 47 open tabs.',
    icon: '✓',
  },
  {
    eyebrow: 'Step 3',
    title: 'Make the thing',
    description: 'Add notes, materials, and progress details. Row counter, voice mode, and all the tools to get from "casting on" to "finished object."',
    icon: '🧶',
  },
];
---

<BaseLayout
  title="Pattern Vault — Your craft library, in your pocket"
  description="Save patterns from Ravelry, Etsy, TikTok, and anywhere else. Track projects, add notes, and stop losing that pattern you saved three months ago. For crafters who collect more patterns than they can make."
>
  <div class="home gradient-mesh">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-mascot-wrap">
        <AnimatedPip animation="idle" size={160} class="hero-mascot" />
      </div>
      <h1 id="hero-heading" class="hero-title">
        Your craft library,<br /><span class="hero-title-accent">in your pocket</span>
      </h1>
      <p class="hero-subtitle">
        Pattern Vault is the one place where every pattern, tutorial, and project idea — no matter where you found it — gets saved, organized, and tracked from "I want to make this" to "I finished it."
      </p>
      <p class="hero-tagline">
        Save from Ravelry, Etsy, TikTok, YouTube, blogs. Track your projects. Add notes. Everything in one place instead of everywhere.
      </p>
      <div class="hero-cta-stack">
        <div class="hero-cta">
          <CTA
            href={ctaConfig.primary.href}
            label={ctaConfig.primary.label}
            primary={true}
            dataCta="cta_impression"
            dataDestination={ctaConfig.primary.destination}
            dataMode={ctaConfig.mode}
            dataPageSection="hero"
            dataFallbackUsed="false"
          />
        </div>
        <div class="hero-cta">
          <CTA
            href={ctaConfig.fallback.href}
            label={ctaConfig.fallback.label}
            primary={false}
            dataCta="cta_impression"
            dataDestination={ctaConfig.fallback.destination}
            dataMode={ctaConfig.mode}
            dataPageSection="hero"
            dataFallbackUsed="true"
          />
        </div>
      </div>
      <p class="hero-note">
        {ctaConfig.mode === 'liveFirst' ? 'iOS only. Designed for crafters who save patterns from everywhere.' : 'Only 12 beta testing spots available. Help shape Pattern Vault before public launch.'}
      </p>
    </section>

    <section class="trust-row" aria-label="Trust signals">
      <p class="trust-chip reveal">Built by crafters</p>
      <p class="trust-chip reveal">Privacy-first by default</p>
      <p class="trust-chip reveal">No tracking, ever</p>
    </section>

    <section class="features" aria-labelledby="features-heading">
      <h2 id="features-heading" class="section-title reveal">Here's the idea</h2>
      <div class="features-grid">
        {features.map((f, i) => (
          <div class="feature-wrap reveal" style={`--reveal-order: ${i}`}>
            <FeatureCard title={f.title} description={f.description} icon={f.icon} eyebrow={f.eyebrow} />
          </div>
        ))}
      </div>
    </section>

    <section class="beta-tracker-section reveal" aria-label="Beta launch progress">
      <LaunchTracker />
    </section>

    <section class="quiz-promo" aria-labelledby="quiz-promo-heading">
      <div class="quiz-promo-inner reveal">
        <img src="/images/pip/curious.png" alt="Our mascot crow looking curious" class="quiz-promo-pip" width="100" height="100" />
        <div class="quiz-promo-content">
          <h2 id="quiz-promo-heading" class="quiz-promo-title">What kind of crafter are you?</h2>
          <p class="quiz-promo-text">Take the quiz to discover your crafting archetype. It takes 2 minutes and the results are surprisingly accurate.</p>
          <a href="/quiz" class="pv-button-primary quiz-promo-btn">Take the Quiz</a>
        </div>
      </div>
    </section>

    <section class="poll-section reveal" aria-label="Mascot naming poll">
      <MascotPoll />
    </section>

    <section class="cta-section" aria-labelledby="cta-heading">
      <h2 id="cta-heading" class="visually-hidden">Join the beta</h2>
      <p class="cta-text reveal">Stop losing patterns. Start finishing projects.</p>
      <div class="cta-actions reveal">
        <CTA
          href={ctaConfig.primary.href}
          label={ctaConfig.primary.label}
          primary={true}
          dataCta="cta_impression"
          dataDestination={ctaConfig.primary.destination}
          dataMode={ctaConfig.mode}
          dataPageSection="closing"
          dataFallbackUsed="false"
        />
        <CTA
          href={ctaConfig.fallback.href}
          label={ctaConfig.fallback.label}
          primary={false}
          dataCta="cta_impression"
          dataDestination={ctaConfig.fallback.destination}
          dataMode={ctaConfig.mode}
          dataPageSection="closing"
          dataFallbackUsed="true"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initReveals() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const els = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0 }
    );
    els.forEach((el) => io.observe(el));
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveals);
  } else {
    initReveals();
  }
</script>

<style>
  .home {
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .hero {
    text-align: center;
    padding: var(--space-4xl) var(--space-lg) var(--space-3xl);
    max-width: var(--content-max);
    margin: 0 auto;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero {
      max-width: none;
      padding: var(--space-4xl) var(--space-2xl) var(--space-3xl);
    }

    .hero-subtitle,
    .hero-tagline {
      max-width: 42rem;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-section {
      padding: var(--space-4xl) var(--space-2xl);
    }
  }

  .hero-mascot-wrap {
    margin: 0 auto var(--space-xl);
    filter: drop-shadow(var(--shadow-glow-coral));
  }

  .hero-mascot {
    width: 160px;
    height: 160px;
    max-width: 100%;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    animation: float 4s ease-in-out infinite;
  }

  @media (min-width: 1024px) {
    .hero-mascot {
      width: 220px;
      height: 220px;
    }
  }

  .hero-title {
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-tight);
    color: var(--deep-plum);
    margin: 0 0 var(--space-lg);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.2s both;
  }

  .hero-title-accent {
    background: linear-gradient(135deg, var(--soft-coral), var(--sage-green));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title::after {
    content: '';
    display: block;
    width: 4rem;
    height: 4px;
    margin: var(--space-md) auto 0;
    background: linear-gradient(90deg, var(--soft-coral), var(--sage-green));
    border-radius: var(--radius-full);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.35s both;
  }

  .hero-subtitle {
    font-size: var(--text-subtitle);
    line-height: var(--line-height-relaxed);
    color: var(--deep-plum);
    margin: 0 0 var(--space-md);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.4s both;
  }

  .hero-tagline {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0 0 var(--space-xl);
    line-height: var(--line-height-relaxed);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.5s both;
  }

  .hero-cta {
    margin-bottom: var(--space-sm);
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.6s both;
  }

  .hero-cta-stack {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero-note {
    font-size: var(--text-small);
    color: var(--text-muted);
    margin: 0;
    animation: fade-in-up var(--duration-slow) var(--ease-out-expo) 0.7s both;
  }

  .section-title {
    font-size: var(--text-title);
    font-weight: 700;
    letter-spacing: var(--letter-tight);
    color: var(--deep-plum);
    text-align: center;
    margin: 0 0 var(--space-2xl);
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s var(--ease-out-expo), transform 0.7s var(--ease-out-expo);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .feature-wrap.reveal {
    transition-delay: calc(var(--reveal-order, 0) * 0.1s);
  }

  .features {
    padding: var(--space-4xl) 0;
  }

  .trust-row {
    margin: 0 auto;
    max-width: var(--content-max);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0 var(--space-md);
  }

  .trust-chip {
    margin: 0;
    font-size: var(--text-small);
    color: var(--deep-plum);
    background: rgba(168, 197, 160, 0.18);
    border: 1px solid rgba(74, 32, 64, 0.08);
    border-radius: var(--radius-full);
    padding: 0.45rem 0.85rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
    }
  }

  .cta-section {
    text-align: center;
    padding: var(--space-4xl) var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .cta-text {
    font-size: var(--text-title);
    font-weight: 600;
    color: var(--deep-plum);
    margin: 0 0 var(--space-xl);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }

  .quiz-promo {
    padding: var(--space-3xl) var(--space-lg);
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .quiz-promo-inner {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-xl);
    border-radius: 20px;
    background: color-mix(in srgb, var(--sage-green) 8%, white);
    border: 1.5px solid color-mix(in srgb, var(--sage-green) 25%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .quiz-promo-pip {
    flex-shrink: 0;
    animation: float 4s ease-in-out infinite;
  }

  .quiz-promo-content {
    flex: 1;
  }

  .quiz-promo-title {
    font-size: var(--text-title);
    font-weight: 700;
    color: var(--deep-plum);
    margin: 0 0 var(--space-sm);
  }

  .quiz-promo-text {
    font-size: var(--text-body);
    color: var(--text-muted);
    margin: 0 0 var(--space-md);
    line-height: var(--line-height-relaxed);
  }

  .quiz-promo-btn {
    display: inline-block;
    text-decoration: none;
    text-align: center;
  }

  @media (max-width: 640px) {
    .quiz-promo-inner {
      flex-direction: column;
      text-align: center;
    }
  }

  .beta-tracker-section {
    padding: var(--space-xl) var(--space-lg) 0;
  }

  .poll-section {
    padding: 0 var(--space-lg) var(--space-2xl);
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
